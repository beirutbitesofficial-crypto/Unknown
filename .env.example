# PostgreSQL. Use a dedicated application role in production; do not use the migration owner role.
DATABASE_URL="postgresql://app_user:password@localhost:5432/ledgerly"
# Optional privileged owner connection used only by Prisma migrations / RLS installation.
MIGRATION_DATABASE_URL="postgresql://migration_owner:password@localhost:5432/ledgerly"

# Better Auth
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ledgerly"

# Transactional email adapter (provider implementation added in deployment)
EMAIL_FROM="Ledgerly <no-reply@example.com>"

# Optional object storage for product images / receipts / logos
STORAGE_PUBLIC_BASE_URL=""
STORAGE_BUCKET=""
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""

# Whish billing. Manual transfer works with recipient only; gateway fields are reserved for merchant onboarding.
WHISH_MERCHANT_RECIPIENT=""
WHISH_PAY_API_URL=""
WHISH_PAY_API_KEY=""
