generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  AR
  EN
}

enum Currency {
  USD
  LBP
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SystemRoleKey {
  OWNER
  MANAGER
  CASHIER
  EMPLOYEE
  CUSTOM
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum CategoryKind {
  PRODUCT
  EXPENSE
  SERVICE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  WHISH
  OMT
  BANK_TRANSFER
  OTHER
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  SALE
  SALE_RETURN
  MANUAL_ADJUSTMENT
  PURCHASE
}

enum ExpenseRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtDirection {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum TransactionDirection {
  IN
  OUT
}

enum TransactionType {
  SALE_PAYMENT
  CUSTOMER_DEBT_PAYMENT
  SUPPLIER_DEBT_PAYMENT
  EXPENSE
  REFUND
  ADJUSTMENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum NotificationType {
  LOW_STOCK
  CUSTOMER_DEBT_OVERDUE
  SUPPLIER_PAYMENT_DUE
  SUBSCRIPTION
  SECURITY
  SYSTEM
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
  OPERATIONS
}

enum AdminAccessScope {
  BUSINESS_PROFILE
  BILLING
  FINANCIAL_READ
  TECHNICAL_SUPPORT
}

enum AddonStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum WebsiteKind {
  GENERAL
  RESTAURANT
  RETAIL
  BOOKING
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DINE_IN
  PICKUP
  DELIVERY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingPaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

// Better Auth core models. Business tenancy starts at BusinessMember, not at the auth tables.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?
  locale        Locale   @default(AR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  memberships         BusinessMember[]
  platformAdmin       PlatformAdmin?
  grantedAdminAccess     BusinessAccessGrant[] @relation("GrantedAdminAccess")
  issuedAdminAccessGrants BusinessAccessGrant[] @relation("AdminGrantor")
  adminAuditLogs         AdminAuditLog[]        @relation("AdminActor")

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Business {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  category    String
  phone       String?
  email       String?
  status      BusinessStatus @default(ACTIVE)
  onboardingCompletedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  settings             BusinessSettings?
  members              BusinessMember[]
  roles                Role[]
  categories           Category[]
  customers            Customer[]
  suppliers            Supplier[]
  products             Product[]
  inventoryTransactions InventoryTransaction[]
  sales                Sale[]
  payments             Payment[]
  expenses             Expense[]
  debts                Debt[]
  debtPayments         DebtPayment[]
  invoices             Invoice[]
  transactions         Transaction[]
  subscription         Subscription?
  notifications        Notification[]
  auditLogs            AuditLog[]
  accessGrants         BusinessAccessGrant[]
  addons               BusinessAddon[]
  website              BusinessWebsite?
  customDomains        CustomDomain[]
  onlineOrders         OnlineOrder[]
  bookingResources     BookingResource[]
  bookingResourceServices BookingResourceService[]
  bookings             Booking[]
  bookingBlocks        BookingBlock[]
  addonPayments        AddonPayment[]

  @@index([status, createdAt])
  @@index([deletedAt])
}

model BusinessSettings {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  logoUrl               String?
  legalName             String?
  phone                  String?
  whatsapp               String?
  address                String?
  email                  String?
  preferredLocale        Locale   @default(AR)
  timezone               String   @default("Asia/Beirut")
  defaultCurrency        Currency @default(USD)
  secondaryCurrency      Currency? @default(LBP)
  usdToLbpRate           Decimal? @db.Decimal(20, 4)
  taxEnabled             Boolean  @default(false)
  taxRatePercent         Decimal? @db.Decimal(7, 4)
  taxNumber              String?
  invoicePrefix          String   @default("INV")
  invoiceNextNumber      Int      @default(1)
  receiptFooter          String?
  whatsappDebtTemplateAr String   @default("مرحبا [Name]، تذكير بسيط إنو باقي عليك [Amount]. شكراً ❤️")
  whatsappDebtTemplateEn String   @default("Hi [Name], a friendly reminder that [Amount] is still outstanding. Thank you ❤️")
  notificationSettings   Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id          String       @id @default(cuid())
  businessId  String
  userId      String
  roleId      String
  status      MemberStatus @default(ACTIVE)
  invitedAt   DateTime?
  joinedAt    DateTime?    @default(now())
  lastActiveAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdSales            Sale[]                 @relation("SaleCreatedBy")
  createdInventoryTx      InventoryTransaction[] @relation("InventoryCreatedBy")
  createdExpenses         Expense[]              @relation("ExpenseCreatedBy")
  recordedDebtPayments    DebtPayment[]          @relation("DebtPaymentCreatedBy")
  createdTransactions     Transaction[]          @relation("TransactionCreatedBy")
  auditLogs               AuditLog[]
  bookingResources        BookingResource[]

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, status])
  @@index([deletedAt])
}

model Role {
  id          String        @id @default(cuid())
  businessId  String
  name        String
  systemKey   SystemRoleKey @default(CUSTOM)
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members     BusinessMember[]
  permissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId, systemKey])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  whatsapp   String?
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales        Sale[]
  debts        Debt[]
  onlineOrders OnlineOrder[]
  bookings     Booking[]

  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, whatsapp])
  @@index([businessId, deletedAt])
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  whatsapp   String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  debts    Debt[]

  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, deletedAt])
}

model Category {
  id         String       @id @default(cuid())
  businessId String
  name       String
  kind       CategoryKind
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  expenses Expense[]

  @@unique([businessId, kind, name])
  @@index([businessId, kind, deletedAt])
}

model Product {
  id             String      @id @default(cuid())
  businessId     String
  categoryId     String?
  type           ProductType
  name           String
  sku            String?
  barcode        String?
  cost           Decimal?    @db.Decimal(20, 4)
  sellingPrice   Decimal     @db.Decimal(20, 4)
  currency       Currency
  stockQuantity  Decimal?    @db.Decimal(20, 3)
  minimumStock   Decimal?    @db.Decimal(20, 3)
  durationMinutes Int?
  imageUrl       String?
  description       String?
  isActive          Boolean     @default(true)
  isPublishedOnline Boolean     @default(false)
  onlineSortOrder   Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]
  onlineOrderItems      OnlineOrderItem[]
  bookingResources      BookingResourceService[]
  bookings              Booking[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, type, isActive])
  @@index([businessId, name])
  @@index([businessId, deletedAt])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  businessId       String
  productId        String
  type             InventoryTransactionType
  quantityDelta    Decimal                  @db.Decimal(20, 3)
  quantityBefore   Decimal                  @db.Decimal(20, 3)
  quantityAfter    Decimal                  @db.Decimal(20, 3)
  unitCost         Decimal?                 @db.Decimal(20, 4)
  currency         Currency?
  reason           String?
  referenceSaleId  String?
  createdByMemberId String?
  createdAt        DateTime                 @default(now())

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  referenceSale  Sale?           @relation(fields: [referenceSaleId], references: [id], onDelete: SetNull)
  createdBy      BusinessMember? @relation("InventoryCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([businessId, productId, createdAt])
  @@index([businessId, type, createdAt])
  @@index([referenceSaleId])
}

model Sale {
  id                  String        @id @default(cuid())
  businessId          String
  customerId          String?
  createdByMemberId   String?
  status              SaleStatus    @default(COMPLETED)
  paymentStatus       PaymentStatus @default(UNPAID)
  currency            Currency
  exchangeRateSnapshot Decimal?     @db.Decimal(20, 4)
  subtotal            Decimal       @db.Decimal(20, 4)
  discountAmount      Decimal       @default(0) @db.Decimal(20, 4)
  taxAmount           Decimal       @default(0) @db.Decimal(20, 4)
  total               Decimal       @db.Decimal(20, 4)
  amountPaid          Decimal       @default(0) @db.Decimal(20, 4)
  balanceDue          Decimal       @default(0) @db.Decimal(20, 4)
  notes               String?
  soldAt              DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy           BusinessMember?  @relation("SaleCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  items               SaleItem[]
  payments            Payment[]
  inventoryTransactions InventoryTransaction[]
  invoice             Invoice?
  debt                Debt?
  transactions        Transaction[]
  onlineOrder         OnlineOrder?

  @@index([businessId, soldAt])
  @@index([businessId, customerId, soldAt])
  @@index([businessId, status, soldAt])
  @@index([businessId, paymentStatus, soldAt])
  @@index([businessId, deletedAt])
}

model SaleItem {
  id                   String      @id @default(cuid())
  saleId               String
  productId            String?
  itemNameSnapshot     String
  itemTypeSnapshot     ProductType
  itemCurrencySnapshot Currency
  exchangeRateSnapshot Decimal?    @db.Decimal(20, 4)
  quantity             Decimal     @db.Decimal(20, 3)
  unitPrice            Decimal     @db.Decimal(20, 4)
  unitCostSnapshot     Decimal?    @db.Decimal(20, 4)
  discountAmount       Decimal     @default(0) @db.Decimal(20, 4)
  lineTotal            Decimal     @db.Decimal(20, 4)
  createdAt            DateTime    @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id                   String        @id @default(cuid())
  businessId           String
  saleId               String
  amount               Decimal       @db.Decimal(20, 4)
  currency             Currency
  exchangeRateSnapshot Decimal?      @db.Decimal(20, 4)
  method               PaymentMethod
  reference            String?
  paidAt               DateTime      @default(now())
  createdAt            DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([businessId, paidAt])
  @@index([businessId, method, paidAt])
  @@index([saleId])
}

model Expense {
  id                  String            @id @default(cuid())
  businessId          String
  categoryId          String?
  createdByMemberId   String?
  title               String
  amount              Decimal           @db.Decimal(20, 4)
  currency            Currency
  exchangeRateSnapshot Decimal?         @db.Decimal(20, 4)
  expenseDate         DateTime          @default(now())
  notes               String?
  receiptImageUrl     String?
  recurrence          ExpenseRecurrence @default(NONE)
  nextOccurrenceAt    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   BusinessMember? @relation("ExpenseCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([businessId, expenseDate])
  @@index([businessId, categoryId, expenseDate])
  @@index([businessId, deletedAt])
}

model Debt {
  id                  String        @id @default(cuid())
  businessId          String
  direction           DebtDirection
  customerId          String?
  supplierId          String?
  sourceSaleId        String?       @unique
  principalAmount     Decimal       @db.Decimal(20, 4)
  amountPaid          Decimal       @default(0) @db.Decimal(20, 4)
  balanceRemaining    Decimal       @db.Decimal(20, 4)
  currency            Currency
  status              DebtStatus    @default(UNPAID)
  debtDate            DateTime      @default(now())
  dueDate             DateTime?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sourceSale Sale?      @relation(fields: [sourceSaleId], references: [id], onDelete: SetNull)
  payments   DebtPayment[]

  @@index([businessId, direction, status, dueDate])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, supplierId, createdAt])
  @@index([businessId, deletedAt])
}

model DebtPayment {
  id                   String        @id @default(cuid())
  businessId           String
  debtId               String
  createdByMemberId    String?
  amount               Decimal       @db.Decimal(20, 4)
  currency             Currency
  exchangeRateSnapshot Decimal?      @db.Decimal(20, 4)
  method               PaymentMethod
  notes                String?
  paidAt               DateTime      @default(now())
  createdAt            DateTime      @default(now())

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  debt      Debt            @relation(fields: [debtId], references: [id], onDelete: Restrict)
  createdBy BusinessMember? @relation("DebtPaymentCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([businessId, paidAt])
  @@index([debtId, paidAt])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  saleId        String        @unique
  invoiceNumber String
  status        InvoiceStatus @default(ISSUED)
  pdfStorageKey String?
  shareToken    String?       @unique
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([businessId, invoiceNumber])
  @@index([businessId, issuedAt])
}

model Transaction {
  id                   String               @id @default(cuid())
  businessId           String
  createdByMemberId    String?
  saleId               String?
  expenseId            String?
  debtPaymentId        String?
  type                 TransactionType
  direction            TransactionDirection
  amount               Decimal              @db.Decimal(20, 4)
  currency             Currency
  exchangeRateSnapshot Decimal?             @db.Decimal(20, 4)
  paymentMethod        PaymentMethod?
  description          String?
  occurredAt           DateTime             @default(now())
  createdAt            DateTime             @default(now())
  voidedAt             DateTime?

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   BusinessMember? @relation("TransactionCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  sale        Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expense     Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  debtPayment DebtPayment?    @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
  @@index([businessId, type, occurredAt])
  @@index([saleId])
  @@index([expenseId])
  @@index([debtPaymentId])
}

model SubscriptionPlan {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  description     String?
  monthlyPriceUsd Decimal         @db.Decimal(12, 2)
  yearlyPriceUsd  Decimal?        @db.Decimal(12, 2)
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  featureFlags    Json
  limits          Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                     String             @id @default(cuid())
  businessId             String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval    @default(MONTHLY)
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  gracePeriodEndsAt      DateTime?
  cancelledAt            DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([status, currentPeriodEndsAt])
  @@index([planId, status])
  @@index([provider, providerSubscriptionId])
}

model SubscriptionPayment {
  id                String   @id @default(cuid())
  subscriptionId    String
  provider           String?
  providerPaymentId String?
  amountUsd          Decimal  @db.Decimal(12, 2)
  status             String
  paidAt             DateTime?
  metadata           Json?
  createdAt          DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId, createdAt])
}

model AddonPlan {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  description        String?
  monthlyPriceUsd    Decimal  @db.Decimal(12, 2)
  yearlyPriceUsd     Decimal? @db.Decimal(12, 2)
  featureCode        String   @unique
  applicableCategories Json?
  configSchema       Json?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  businessAddons BusinessAddon[]

  @@index([isActive, sortOrder])
}

model BusinessAddon {
  id                     String      @id @default(cuid())
  businessId             String
  addonPlanId            String
  status                 AddonStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  gracePeriodEndsAt      DateTime?
  cancelledAt            DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  config                 Json?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addonPlan  AddonPlan @relation(fields: [addonPlanId], references: [id], onDelete: Restrict)
  payments   AddonPayment[]

  @@unique([businessId, addonPlanId])
  @@index([businessId, status])
  @@index([provider, providerSubscriptionId])
}

model AddonPayment {
  id                String   @id @default(cuid())
  businessId        String
  businessAddonId   String
  provider          String?
  providerPaymentId String?
  amountUsd         Decimal  @db.Decimal(12, 2)
  status            String
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessAddon BusinessAddon @relation(fields: [businessAddonId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([businessId, createdAt])
  @@index([businessAddonId, createdAt])
}

model WebsiteTemplate {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  kind         WebsiteKind
  description  String?
  categoryTags Json?
  themeConfig  Json
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  websites BusinessWebsite[]

  @@index([kind, isActive, sortOrder])
}

// Public routing metadata. Financial/private tenant tables remain RLS protected.
model BusinessWebsite {
  id             String        @id @default(cuid())
  businessId     String        @unique
  templateId     String?
  slug           String        @unique
  status         WebsiteStatus @default(DRAFT)
  title          String?
  tagline        String?
  primaryColor   String?
  accentColor    String?
  heroImageUrl   String?
  modules        Json?
  settings       Json?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template WebsiteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  domains  CustomDomain[]
  orders   OnlineOrder[]
  bookings Booking[]

  @@index([status, publishedAt])
  @@index([templateId])
}

model CustomDomain {
  id         String       @id @default(cuid())
  businessId String
  websiteId  String
  hostname   String       @unique
  status     DomainStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website  BusinessWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([websiteId])
}

model OnlineOrder {
  id             String            @id @default(cuid())
  businessId     String
  websiteId      String
  customerId     String?
  saleId         String?           @unique
  orderNumber    String
  status         OnlineOrderStatus @default(PENDING)
  fulfillment    FulfillmentType
  currency       Currency
  subtotal       Decimal           @db.Decimal(20, 4)
  discountAmount Decimal           @default(0) @db.Decimal(20, 4)
  deliveryFee    Decimal           @default(0) @db.Decimal(20, 4)
  total          Decimal           @db.Decimal(20, 4)
  paymentStatus  PaymentStatus     @default(UNPAID)
  paymentMethod  PaymentMethod?
  customerName   String
  customerPhone  String
  address        String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website  BusinessWebsite @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    OnlineOrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerPhone, createdAt])
}

model OnlineOrderItem {
  id             String   @id @default(cuid())
  onlineOrderId  String
  productId      String?
  itemNameSnapshot String
  quantity       Decimal  @db.Decimal(20, 3)
  unitPrice      Decimal  @db.Decimal(20, 4)
  lineTotal      Decimal  @db.Decimal(20, 4)
  createdAt      DateTime @default(now())

  order   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([onlineOrderId])
  @@index([productId])
}

model BookingResource {
  id                   String   @id @default(cuid())
  businessId           String
  memberId             String?
  name                 String
  title                String?
  imageUrl             String?
  isActive             Boolean  @default(true)
  weeklySchedule       Json?
  bookingBufferMinutes Int      @default(0)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member   BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  services BookingResourceService[]
  bookings Booking[]
  blocks   BookingBlock[]

  @@index([businessId, isActive, sortOrder])
  @@index([businessId, memberId])
}

model BookingResourceService {
  id              String   @id @default(cuid())
  businessId      String
  resourceId      String
  productId       String
  durationMinutes Int?
  priceOverride   Decimal? @db.Decimal(20, 4)
  currency        Currency?
  createdAt       DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([resourceId, productId])
  @@index([businessId, productId])
}

model Booking {
  id            String               @id @default(cuid())
  businessId    String
  websiteId     String
  customerId    String?
  resourceId    String
  productId     String
  status        BookingStatus        @default(PENDING)
  paymentStatus BookingPaymentStatus @default(UNPAID)
  startAt       DateTime
  endAt         DateTime
  customerName  String
  customerPhone String
  whatsapp      String?
  email         String?
  notes         String?
  internalNotes String?
  price         Decimal              @db.Decimal(20, 4)
  currency      Currency
  depositAmount Decimal              @default(0) @db.Decimal(20, 4)
  amountPaid    Decimal              @default(0) @db.Decimal(20, 4)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website  BusinessWebsite @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([businessId, startAt])
  @@index([businessId, resourceId, startAt])
  @@index([businessId, customerPhone, createdAt])
  @@index([businessId, status, startAt])
}

model BookingBlock {
  id         String   @id @default(cuid())
  businessId String
  resourceId String
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([businessId, resourceId, startAt, endAt])
}

model Notification {
  id         String           @id @default(cuid())
  businessId String
  type       NotificationType
  title      String
  body       String
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, readAt, createdAt])
  @@index([businessId, type, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  memberId   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member   BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, memberId, createdAt])
}

model PlatformAdmin {
  id        String            @id @default(cuid())
  userId    String            @unique
  role      PlatformAdminRole @default(SUPPORT)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessAccessGrant {
  id             String           @id @default(cuid())
  businessId     String
  adminUserId    String
  grantedByUserId String?
  scope          AdminAccessScope
  reason         String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adminUser     User     @relation("GrantedAdminAccess", fields: [adminUserId], references: [id], onDelete: Cascade)
  grantedByUser User?    @relation("AdminGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, scope, expiresAt])
  @@index([adminUserId, expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  reason      String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User @relation("AdminActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model SystemAnnouncement {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String
  bodyAr      String
  bodyEn      String
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  audience    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

// Database-backed Better Auth rate limiting for multi-instance/serverless deployments.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}
